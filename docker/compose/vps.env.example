# Copy to .env next to vps.yaml. Every value is read at start; recreate the
# containers after a change: docker compose -f vps.yaml up -d

# --- Set these ---

# Domain the site answers on, its DNS pointing at this machine. `localhost`
# tries it out locally with a certificate from Caddy's own CA.
DOMAIN=
# Django's signing key; generate once with `openssl rand -base64 48` and keep
# it, changing it logs everyone out.
SECRET_KEY=
# Database password; it goes into a URL, so generate with `openssl rand -hex 32`.
DB_PASSWORD=
# Login created on the first start; later starts never change it.
ADMIN_USERNAME=admin
# Password of that login; empty creates none.
ADMIN_PASSWORD=

# --- Optional; the values shown are the defaults ---

# Image tag; pin `sha-<commit>` or a version so a restart never upgrades.
# IMAGE_TAG=latest
# Host names the site answers to, comma-separated; defaults to DOMAIN.
# ALLOWED_HOSTS=example.com,www.example.com
# Path of the admin, with a trailing slash; pick one of your own.
# ADMIN_URL=admin/
# Site title until the profile has a name.
# SITE_NAME=lapidarium
# Interface language, `pl` or `en`.
# LANGUAGE_CODE=pl
# Time zone for calendar entries and feeds.
# TIME_ZONE=Europe/Warsaw
# Bundled demo loaded on the first start, `ttrpg` or `dev`.
# DEMO_CONTENT=

# Mail for the contact form; the default only prints to the log.
# EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=webmaster@localhost

# Newsletter: `log` writes sign-ups to the log, `mailchimp` sends them on.
# NEWSLETTER_BACKEND=log
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=

# Theme by directory name; a directory of your own needs a volume under web.
# SITE_THEME=base
# SITE_THEME_DIRS=

# Uploads go to the `media` volume. A Google Cloud Storage bucket replaces it;
# a key file needs a volume under web.
# GS_BUCKET_NAME=
# GS_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=

# Caches; point both at a shared cache only with more than one web container.
# CACHE_URL=locmemcache://
# PAGE_CACHE_URL=filecache:///tmp/lapidarium-pages
# PAGE_CACHE_SECONDS=600

# Proxies appending to X-Forwarded-For; Caddy is one. Add one per CDN in front.
# TRUSTED_PROXY_HOPS=1
# Where collectstatic writes inside the container.
# STATIC_ROOT=staticfiles

# Database name and user, fixed once the database volume exists.
# DB_NAME=lapidarium
# DB_USER=lapidarium
