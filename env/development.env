# Dev baseline, loaded by mise for every task. Personal overrides go in
# mise.local.toml (gitignored), never here.
ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://lapidarium:lapidarium@localhost:5432/lapidarium
DJANGO_SETTINGS_MODULE=lapidarium.edges.settings
SITE_NAME="lapidarium (dev)"
