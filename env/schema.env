# @currentEnv=$ENV @defaultSensitive=false @defaultRequired=false
# ---
# Runtime configuration the engine reads (src/lapidarium/edges/settings.py).
# Defaults live in settings.py, not here: a key left empty falls back to it.
# Dev and test values come from the other env/*.env files through mise; deploy
# values come from the GitHub Environment, validated here before they are
# synced to Coolify.

# @type=enum(development, production, test) @required
ENV=
# @type=boolean
DEBUG=
# @sensitive @required
SECRET_KEY=
# Comma-separated; a leading dot matches subdomains.
# @required
ALLOWED_HOSTS=
# @sensitive @required @example=postgres://user:pass@host:5432/lapidarium
DATABASE_URL=

SITE_NAME=
# Theme directory name, searched in SITE_THEME_DIRS before the engine's.
SITE_THEME=
# Comma-separated directories holding instance themes.
SITE_THEME_DIRS=
# Path the admin is mounted under, with a trailing slash.
# @type=string(matches=regex("^.+/$"))
ADMIN_URL=

LANGUAGE_CODE=
TIME_ZONE=

STATIC_ROOT=
MEDIA_ROOT=
# @type=string(matches=regex("^.+/$"))
MEDIA_URL=
# Media goes to this bucket when set, to MEDIA_ROOT otherwise.
GS_BUCKET_NAME=
GS_LOCATION=
# Service-account key file; unset on GCP, where the attached account is used.
GOOGLE_APPLICATION_CREDENTIALS=

# django-environ cache URLs; either may embed a password.
# @sensitive
CACHE_URL=
# @sensitive
PAGE_CACHE_URL=
# @type=number(min=0, isInt=true)
PAGE_CACHE_SECONDS=

# May embed smtp://user:pass@host.
# @sensitive
EMAIL_URL=
DEFAULT_FROM_EMAIL=

# @type=enum(log, mailchimp)
NEWSLETTER_BACKEND=
# @sensitive
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Proxies in front that append to X-Forwarded-For.
# @type=number(min=0, isInt=true)
TRUSTED_PROXY_HOPS=

DJANGO_SETTINGS_MODULE=lapidarium.edges.settings
