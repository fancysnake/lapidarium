# Every key from development.env is repeated: a task env file layers over the
# dev one, so a key left out would keep its dev value.
ENV=test
DEBUG=false
SECRET_KEY=test-secret-key
ALLOWED_HOSTS=testserver
DATABASE_URL=postgres://lapidarium:lapidarium@localhost:5432/lapidarium
DJANGO_SETTINGS_MODULE=lapidarium.edges.settings
SITE_NAME="lapidarium (test)"
ADMIN_URL=admin/
IN_TESTS=true
